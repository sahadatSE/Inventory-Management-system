@page
@model WebApplication1.Pages.Admin.NotificationModel
@{
    ViewData["Title"] = "Notifications";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Notifications</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f0f2f5;
            font-family: 'Segoe UI', sans-serif;
        }

        .notif-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        .notif-item {
            border-left: 5px solid;
            border-radius: 8px;
            padding: 14px 16px;
            margin-bottom: 12px;
            background: #fff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

            .notif-item.danger {
                border-color: #dc3545;
            }

            .notif-item.warning {
                border-color: #ffc107;
            }

        .notif-icon {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }
    </style>
</head>
<body>
    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-0">
                    <i class="bi bi-bell-fill text-danger"></i> Notifications
                </h3>
                <small class="text-muted">Stock alerts and warnings</small>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-danger fs-6">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    @Model.OutOfStockList.Count Out of Stock
                </span>
                <span class="badge bg-warning text-dark fs-6">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    @Model.LowStockList.Count Low Stock
                </span>
            </div>
        </div>

        <div class="notif-card card mb-4">
            <div class="card-header bg-danger text-white fw-bold rounded-top">
                <i class="bi bi-x-circle-fill"></i>
                Out of Stock — @Model.OutOfStockList.Count product(s)
            </div>
            <div class="card-body">
                @if (Model.OutOfStockList.Count == 0)
                {
                    <div class="text-center text-muted py-3">
                        <i class="bi bi-check-circle-fill text-success fs-3"></i>
                        <p class="mt-2">No out of stock products.</p>
                    </div>
                }
                else
                {
                    foreach (var item in Model.OutOfStockList)
                    {
                        <div class="notif-item danger d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <div class="notif-icon bg-danger bg-opacity-10 text-danger">
                                    <i class="bi bi-box-seam"></i>
                                </div>
                                <div>
                                    <p class="fw-bold mb-0">@item.P_Name</p>
                                    <small class="text-muted">
                                        Total In: <strong class="text-primary">@item.Quantity_In</strong> |
                                        Total Out: <strong class="text-danger">@item.Quantity_Out</strong>
                                    </small>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-danger px-3 py-2 mb-1">Out of Stock</span>
                                <br />
                                <a href="/Admin/Stock" class="btn btn-sm btn-outline-danger mt-1">
                                    <i class="bi bi-plus-circle"></i> Add Stock
                                </a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="notif-card card mb-4">
            <div class="card-header bg-warning text-dark fw-bold rounded-top">
                <i class="bi bi-exclamation-triangle-fill"></i>
                Low Stock (≤ 2) — @Model.LowStockList.Count product(s)
            </div>
            <div class="card-body">
                @if (Model.LowStockList.Count == 0)
                {
                    <div class="text-center text-muted py-3">
                        <i class="bi bi-check-circle-fill text-success fs-3"></i>
                        <p class="mt-2">All products have sufficient stock.</p>
                    </div>
                }
                else
                {
                    foreach (var item in Model.LowStockList)
                    {
                        <div class="notif-item warning d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <div class="notif-icon bg-warning bg-opacity-10 text-warning">
                                    <i class="bi bi-box-seam"></i>
                                </div>
                                <div>
                                    <p class="fw-bold mb-0">@item.P_Name</p>
                                    <small class="text-muted">
                                        Total In: <strong class="text-primary">@item.Quantity_In</strong> |
                                        Total Out: <strong class="text-danger">@item.Quantity_Out</strong> |
                                        Available: <strong class="text-warning">@item.Available_Stock</strong>
                                    </small>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-warning text-dark px-3 py-2 mb-1">Low Stock</span>
                                <br />
                                <a href="/Admin/Stock" class="btn btn-sm btn-outline-warning mt-1">
                                    <i class="bi bi-plus-circle"></i> Add Stock
                                </a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

      
        @if (Model.OutOfStockList.Count == 0 && Model.LowStockList.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                <h4 class="mt-3 text-success fw-bold">All products are sufficiently stocked!</h4>
                <p class="text-muted">No alerts at this time.</p>
                <a href="/Admin/Dashboard" class="btn btn-success mt-2">Back to Dashboard</a>
            </div>
        }

        <div class="text-center mb-5">
            <a href="/Admin/Dashboard" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>