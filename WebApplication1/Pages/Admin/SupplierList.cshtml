@page
@model WebApplication1.Pages.Admin.SupplierListModel
@{
    ViewData["Title"] = "Supplier List";
}

<style>
    body {
        background: #e8f0fe;
    }

    .page-header {
        background: linear-gradient(135deg, #1a56db, #0d6efd);
        color: white;
        padding: 2rem;
        border-radius: 16px;
        margin-bottom: 1.5rem;
    }

    .search-box {
        background: white;
        border-radius: 12px;
        padding: 1rem 1.5rem;
        box-shadow: 0 2px 8px rgba(13,110,253,0.1);
        margin-bottom: 1.5rem;
    }

    .table-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(13,110,253,0.1);
    }

    .table thead tr {
        background: #1a56db;
        color: white;
    }

    .table thead th {
        font-weight: 600;
        padding: 1rem;
        border: none;
    }

    .table tbody tr {
        border-bottom: 1px solid #e8f0fe;
        transition: background 0.2s;
    }

        .table tbody tr:hover {
            background: #f0f5ff;
        }

    .table tbody td {
        padding: 0.85rem 1rem;
        vertical-align: middle;
    }

    .badge-id {
        background: #e8f0fe;
        color: #1a56db;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.85rem;
    }
</style>

<div class="container mt-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header -->
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h4 class="fw-bold mb-1">Supplier Management</h4>
            <small class="opacity-75">Manage all your suppliers in one place</small>
        </div>
        <a asp-page="/Admin/Supplier" class="btn btn-light fw-bold text-primary">
            + Add Supplier
        </a>
    </div>

    <!-- Search -->
    <div class="search-box">
        <form method="get">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">🔍</span>
                <input type="text" name="search" value="@Model.SearchQuery"
                       class="form-control border-start-0"
                       placeholder="Search suppliers by name..." />
                <button class="btn btn-primary" type="submit">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a asp-page="/Admin/SupplierList" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="table-card">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.List.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            No suppliers found.
                        </td>
                    </tr>
                }
                else
                {
                    int i = 1;
                    foreach (var s in Model.List)
                    {
                        <tr>
                            <td><span class="badge-id">@(i++)</span></td>
                            <td class="fw-semibold">@s.SName</td>
                            <td class="text-muted">@s.SEmail</td>
                            <td>@s.SNumber</td>
                            <td class="text-muted">@s.SAdress</td>
                            <td>
                                <a href="/Admin/Supplier?Id=@s.SId"
                                   class="btn btn-sm btn-warning fw-semibold me-1">Edit</a>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@s.SId" />
                                    <button type="submit" asp-page-handler="Delete"
                                            class="btn btn-sm btn-danger fw-semibold"
                                            onclick="return confirm('Delete this supplier?')">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>