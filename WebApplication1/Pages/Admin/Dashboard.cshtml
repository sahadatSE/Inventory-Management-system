@page
@model WebApplication1.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --blue-50:  #eff6ff;
            --blue-100: #dbeafe;
            --blue-200: #bfdbfe;
            --blue-300: #93c5fd;
            --blue-400: #60a5fa;
            --blue-500: #3b82f6;
            --blue-600: #2563eb;
            --blue-700: #1d4ed8;
            --blue-800: #1e40af;
            --blue-900: #1e3a8a;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #e0eaff 0%, #f0f5ff 50%, #e8f0fe 100%);
            min-height: 100vh;
            color: #1e3a8a;
        }

        body::before {
            content: '';
            position: fixed;
            left: 0; top: 0;
            width: 5px; height: 100%;
            background: linear-gradient(180deg, var(--blue-500), var(--blue-800));
            z-index: 999;
        }

        /* ── Top Header ── */
        .top-header {
            background: linear-gradient(135deg, var(--blue-800) 0%, var(--blue-600) 100%);
            padding: 18px 28px;
            display: flex; align-items: center; justify-content: space-between;
            box-shadow: 0 4px 24px rgba(30,64,175,0.35);
            border-radius: 14px;
            margin-bottom: 24px;
        }
        .header-left { display: flex; align-items: center; gap: 12px; }
        .header-icon {
            width: 44px; height: 44px;
            background: rgba(255,255,255,0.18);
            border-radius: 11px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
        }
        .header-title { color: #fff; font-weight: 800; font-size: 1.1rem; margin: 0; }
        .header-sub   { color: var(--blue-200); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.4px; }
        .date-badge {
            background: rgba(255,255,255,0.15);
            border: 1.5px solid rgba(255,255,255,0.3);
            border-radius: 8px;
            padding: 7px 16px;
            color: #fff;
            font-size: 0.82rem;
            font-weight: 600;
            display: flex; align-items: center; gap: 7px;
        }

        /* ── Stat Cards ── */
        .stat-card {
            background: #fff;
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 2px 16px rgba(30,64,175,0.08);
            border: 1px solid var(--blue-100);
            transition: transform 0.2s;
        }
        .stat-card:hover { transform: translateY(-3px); }
        .stat-icon-box {
            width: 50px; height: 50px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem; flex-shrink: 0;
        }
        .stat-num { font-size: 1.8rem; font-weight: 800; line-height: 1.1; margin-bottom: 2px; }
        .stat-label { font-size: 0.75rem; color: #64748b; margin-bottom: 4px; }
        .stat-sub   { font-size: 0.72rem; color: #94a3b8; }
        .stat-link {
            font-size: 0.78rem; font-weight: 700;
            text-decoration: none;
            display: flex; align-items: center; gap: 4px;
            border-top: 1px solid var(--blue-100);
            padding-top: 10px; margin-top: 12px;
        }

        /* ── Chart Card ── */
        .chart-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 4px 30px rgba(30,64,175,0.10);
            border: 1px solid var(--blue-100);
            overflow: hidden;
        }
        .chart-card-header {
            background: linear-gradient(135deg, var(--blue-700), var(--blue-500));
            padding: 14px 22px;
        }
        .chart-card-header .ctitle {
            color: #fff; font-weight: 700; font-size: 0.9rem; margin: 0;
        }
        .chart-card-header .csub {
            color: rgba(255,255,255,0.75); font-size: 0.72rem; margin: 2px 0 0;
        }
        .chart-card-body { padding: 20px; }

        /* ── Bar Chart ── */
        .chart-wrapper {
            display: flex;
            align-items: flex-end;
            gap: 20px;
            height: 200px;
            padding: 0 10px;
            border-bottom: 2px solid var(--blue-200);
            border-left: 2px solid var(--blue-200);
            overflow-x: auto;
        }
        .bar-group {
            display: flex; flex-direction: column;
            align-items: center; gap: 6px; min-width: 70px;
        }
        .bar-wrap { display: flex; align-items: flex-end; gap: 5px; height: 190px; }
        .bar-item {
            display: flex; flex-direction: column;
            align-items: center; justify-content: flex-end; gap: 3px;
        }
        .bar {
            width: 22px; border-radius: 4px 4px 0 0;
            transition: opacity 0.2s; cursor: pointer;
        }
        .bar:hover { opacity: 0.75; }
        .bar-value { font-size: 0.65rem; font-weight: 700; color: #334155; }
        .bar-product-label {
            font-size: 0.7rem; color: #64748b; text-align: center;
            max-width: 75px; white-space: nowrap;
            overflow: hidden; text-overflow: ellipsis; font-weight: 600;
        }
        .y-axis {
            display: flex; flex-direction: column;
            justify-content: space-between;
            height: 190px; padding-bottom: 2px;
            font-size: 0.65rem; color: #94a3b8;
            text-align: right; min-width: 28px;
        }
        .chart-legend {
            display: flex; gap: 16px; font-size: 0.78rem;
            margin-top: 12px; flex-wrap: wrap; color: #64748b;
        }
        .legend-dot {
            width: 11px; height: 11px; border-radius: 3px;
            display: inline-block; margin-right: 5px; vertical-align: middle;
        }

        /* ── Table Card ── */
        .table-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 4px 30px rgba(30,64,175,0.10);
            border: 1px solid var(--blue-100);
            overflow: hidden;
        }
        .table-card-header {
            background: linear-gradient(135deg, var(--blue-700), var(--blue-500));
            padding: 14px 22px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .table-card-header h6 {
            color: #fff; font-weight: 700; font-size: 0.9rem;
            margin: 0; display: flex; align-items: center; gap: 8px;
        }
        .table-count-badge {
            background: rgba(255,255,255,0.2);
            color: #fff; font-size: 0.72rem; font-weight: 700;
            padding: 3px 10px; border-radius: 20px;
        }
        .table { margin: 0; }
        .table thead th {
            background: var(--blue-50);
            font-weight: 700; font-size: 0.7rem;
            text-transform: uppercase; letter-spacing: 0.7px;
            color: var(--blue-700);
            border-bottom: 2px solid var(--blue-100);
            padding: 12px 14px; white-space: nowrap;
        }
        .table tbody tr { border-bottom: 1px solid #f1f5f9; transition: background 0.15s; }
        .table tbody tr:hover { background: var(--blue-50); }
        .table tbody tr:last-child { border-bottom: none; }
        .table tbody td { padding: 11px 14px; font-size: 0.83rem; color: #334155; vertical-align: middle; }

        .row-num {
            width: 26px; height: 26px;
            background: var(--blue-100); color: var(--blue-700);
            border-radius: 7px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 0.72rem;
        }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: var(--blue-50); }
        ::-webkit-scrollbar-thumb { background: var(--blue-300); border-radius: 10px; }
    </style>
</head>
<body>
<div class="container-fluid px-4 py-4">

    <!-- Header -->
    <div class="top-header mt-2">
        <div class="header-left">
            <div class="header-icon">📊</div>
            <div>
                <div class="header-title">Dashboard</div>
                <div class="header-sub">INVENTORY MANAGEMENT SYSTEM — OVERVIEW</div>
            </div>
        </div>
        <div class="date-badge">
            <i class="bi bi-calendar3"></i>
            @DateTime.Now.ToString("dd MMM yyyy")
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <div class="stat-label">Total Registered Users</div>
                        <div class="stat-num" style="color:var(--blue-700);">@Model.TotalUsers</div>
                        <div class="stat-sub">All system users</div>
                    </div>
                    <div class="stat-icon-box" style="background:var(--blue-100);color:var(--blue-700);">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <a href="/Admin/UserList" class="stat-link" style="color:var(--blue-600);">
                    View All Users <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <div class="stat-label">Total Stock Entries</div>
                        <div class="stat-num" style="color:#16a34a;">@Model.TotalStockRecords</div>
                        <div class="stat-sub">All stock records</div>
                    </div>
                    <div class="stat-icon-box" style="background:#dcfce7;color:#16a34a;">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>
                </div>
                <a href="/Admin/StockList" class="stat-link" style="color:#16a34a;">
                    View All Stocks <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <div class="stat-label">Total Available Stock</div>
                        <div class="stat-num" style="color:#b45309;">@Model.TotalAvailableStock</div>
                        <div class="stat-sub">Current in-hand quantity</div>
                    </div>
                    <div class="stat-icon-box" style="background:#fef9c3;color:#b45309;">
                        <i class="bi bi-archive-fill"></i>
                    </div>
                </div>
                <a href="/Admin/StockList" class="stat-link" style="color:#b45309;">
                    View Details <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

    </div>

    <!-- Charts -->
    <div class="row g-3 mb-4">

        <!-- Product Chart -->
        <div class="col-md-8">
            <div class="chart-card">
                <div class="chart-card-header">
                    <div class="ctitle">Stock Overview by Product</div>
                    <div class="csub">Quantity In, Quantity Out and Available Stock per product</div>
                </div>
                <div class="chart-card-body">
                    @{
                        int maxVal = Model.AvailableList.Count > 0
                            ? Model.AvailableList.Max(s => s.Quantity_In) : 1;
                        if (maxVal == 0) maxVal = 1;
                    }
                    <div class="d-flex gap-2">
                        <div class="y-axis">
                            <span>@(maxVal)</span>
                            <span>@(maxVal * 3 / 4)</span>
                            <span>@(maxVal / 2)</span>
                            <span>@(maxVal / 4)</span>
                            <span>0</span>
                        </div>
                        <div class="chart-wrapper flex-grow-1">
                            @foreach (var item in Model.AvailableList)
                            {
                                int inH    = (int)((double)item.Quantity_In    / maxVal * 185);
                                int outH   = (int)((double)item.Quantity_Out   / maxVal * 185);
                                int availH = item.Available_Stock > 0
                                    ? (int)((double)item.Available_Stock / maxVal * 185) : 0;
                                <div class="bar-group">
                                    <div class="bar-wrap">
                                        <div class="bar-item">
                                            <span class="bar-value" style="color:var(--blue-600);">@item.Quantity_In</span>
                                            <div class="bar" style="height:@(inH)px;background:var(--blue-500);"
                                                 title="Qty In: @item.Quantity_In"></div>
                                        </div>
                                        <div class="bar-item">
                                            <span class="bar-value" style="color:#dc2626;">@item.Quantity_Out</span>
                                            <div class="bar bg-danger" style="height:@(outH)px;"
                                                 title="Qty Out: @item.Quantity_Out"></div>
                                        </div>
                                        <div class="bar-item">
                                            <span class="bar-value" style="color:#16a34a;">@item.Available_Stock</span>
                                            <div class="bar bg-success" style="height:@(availH)px;"
                                                 title="Available: @item.Available_Stock"></div>
                                        </div>
                                    </div>
                                    <div class="bar-product-label">@(item.Product?.PName ?? "-")</div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="chart-legend">
                        <span><span class="legend-dot" style="background:var(--blue-500);"></span>Quantity In</span>
                        <span><span class="legend-dot bg-danger"></span>Quantity Out</span>
                        <span><span class="legend-dot bg-success"></span>Available Stock</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Chart -->
        <div class="col-md-4">
            <div class="chart-card h-100">
                <div class="chart-card-header">
                    <div class="ctitle">System Summary</div>
                    <div class="csub">Users, Stock Records & Available Stock</div>
                </div>
                <div class="chart-card-body">
                    @{
                        int maxSummary = Math.Max(
                            Math.Max(Model.TotalUsers, Model.TotalStockRecords),
                            Math.Max(Model.TotalAvailableStock, 1));
                        int uH = (int)((double)Model.TotalUsers         / maxSummary * 185);
                        int sH = (int)((double)Model.TotalStockRecords  / maxSummary * 185);
                        int aH = (int)((double)Model.TotalAvailableStock / maxSummary * 185);
                    }
                    <div class="d-flex gap-2">
                        <div class="y-axis">
                            <span>@maxSummary</span>
                            <span>@(maxSummary * 3 / 4)</span>
                            <span>@(maxSummary / 2)</span>
                            <span>@(maxSummary / 4)</span>
                            <span>0</span>
                        </div>
                        <div class="chart-wrapper flex-grow-1 justify-content-center">
                            <div class="bar-group">
                                <div class="bar-wrap">
                                    <div class="bar-item">
                                        <span class="bar-value" style="color:var(--blue-600);">@Model.TotalUsers</span>
                                        <div class="bar" style="height:@(uH)px;width:34px;background:var(--blue-400);"
                                             title="Total Users: @Model.TotalUsers"></div>
                                    </div>
                                </div>
                                <div class="bar-product-label">Users</div>
                            </div>
                            <div class="bar-group">
                                <div class="bar-wrap">
                                    <div class="bar-item">
                                        <span class="bar-value" style="color:var(--blue-700);">@Model.TotalStockRecords</span>
                                        <div class="bar" style="height:@(sH)px;width:34px;background:var(--blue-600);"
                                             title="Stock Records: @Model.TotalStockRecords"></div>
                                    </div>
                                </div>
                                <div class="bar-product-label">Stocks</div>
                            </div>
                            <div class="bar-group">
                                <div class="bar-wrap">
                                    <div class="bar-item">
                                        <span class="bar-value" style="color:#16a34a;">@Model.TotalAvailableStock</span>
                                        <div class="bar bg-success" style="height:@(aH)px;width:34px;"
                                             title="Available: @Model.TotalAvailableStock"></div>
                                    </div>
                                </div>
                                <div class="bar-product-label">Available</div>
                            </div>
                        </div>
                    </div>
                    <div class="chart-legend">
                        <span><span class="legend-dot" style="background:var(--blue-400);"></span>Users</span>
                        <span><span class="legend-dot" style="background:var(--blue-600);"></span>Stocks</span>
                        <span><span class="legend-dot bg-success"></span>Available</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Tables -->
    <div class="row g-3 mb-5">

        <!-- Available Stock Table -->
        <div class="col-md-6">
            <div class="table-card">
                <div class="table-card-header">
                    <h6><i class="bi bi-archive-fill"></i> Available Stock Summary</h6>
                    <span class="table-count-badge">@Model.AvailableList.Count products</span>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Product</th>
                                <th>Total In</th>
                                <th>Total Out</th>
                                <th>Available</th>
                            </tr>
                        </thead>
                        <tbody class="text-center">
                            @if (Model.AvailableList.Count == 0)
                            {
                                <tr><td colspan="5" class="text-muted py-4">No data found.</td></tr>
                            }
                            else
                            {
                                int j = 1;
                                foreach (var item in Model.AvailableList)
                                {
                                    <tr>
                                        <td><div class="row-num">@(j++)</div></td>
                                        <td class="text-start fw-semibold" style="color:var(--blue-900);">
                                            @(item.Product?.PName ?? "-")
                                        </td>
                                        <td style="color:var(--blue-600);font-weight:700;">@item.Quantity_In</td>
                                        <td class="text-danger fw-bold">@item.Quantity_Out</td>
                                        <td>
                                            <span class="badge @(item.Available_Stock > 0 ? "bg-success" : "bg-danger") px-3 py-2">
                                                @item.Available_Stock
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Recent Stock Table -->
        <div class="col-md-6">
            <div class="table-card">
                <div class="table-card-header">
                    <h6><i class="bi bi-clock-fill"></i> Recent Stock Entries</h6>
                    <span class="table-count-badge">Last 5 records</span>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Product</th>
                                <th>Qty In</th>
                                <th>Qty Out</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody class="text-center">
                            @if (Model.RecentStocks.Count == 0)
                            {
                                <tr><td colspan="5" class="text-muted py-4">No records found.</td></tr>
                            }
                            else
                            {
                                int k = 1;
                                foreach (var item in Model.RecentStocks)
                                {
                                    <tr>
                                        <td><div class="row-num">@(k++)</div></td>
                                        <td class="text-start fw-semibold" style="color:var(--blue-900);">
                                            @(item.Product?.PName ?? "-")
                                        </td>
                                        <td style="color:var(--blue-600);font-weight:700;">@item.Quantity_In</td>
                                        <td class="text-danger fw-bold">@item.Quantity_Out</td>
                                        <td>
                                            <span style="background:var(--blue-100);color:var(--blue-700);padding:3px 10px;border-radius:20px;font-size:0.72rem;font-weight:700;">
                                                @item.EntryDate.ToLocalTime().ToString("dd MMM yyyy")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>