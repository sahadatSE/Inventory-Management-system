@page
@model WebApplication1.Pages.Admin.UserModel
@{
    ViewData["Title"] = "Add User";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add User</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --blue-50:  #eff6ff;
            --blue-100: #dbeafe;
            --blue-200: #bfdbfe;
            --blue-300: #93c5fd;
            --blue-400: #60a5fa;
            --blue-500: #3b82f6;
            --blue-600: #2563eb;
            --blue-700: #1d4ed8;
            --blue-800: #1e40af;
            --blue-900: #1e3a8a;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #e0eaff 0%, #f0f5ff 50%, #e8f0fe 100%);
            min-height: 100vh;
            color: #1e3a8a;
        }

        body::before {
            content: '';
            position: fixed;
            left: 0; top: 0;
            width: 5px; height: 100%;
            background: linear-gradient(180deg, var(--blue-500), var(--blue-800));
            z-index: 999;
        }

        /* ── Card ── */
        .form-card {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 8px 40px rgba(30, 64, 175, 0.13);
            border: 1px solid var(--blue-100);
            overflow: hidden;
            animation: slideUp 0.4s ease both;
        }

        /* ── Card Header ── */
        .form-card-header {
            background: linear-gradient(135deg, var(--blue-800) 0%, var(--blue-600) 100%);
            padding: 22px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-icon {
            width: 44px; height: 44px;
            background: rgba(255,255,255,0.18);
            border-radius: 11px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
            backdrop-filter: blur(6px);
        }

        .header-title {
            color: #fff;
            font-weight: 800;
            font-size: 1.1rem;
            margin: 0;
        }

        .header-sub {
            color: var(--blue-200);
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.4px;
        }

        .back-btn {
            background: rgba(255,255,255,0.15);
            color: #fff;
            border: 1.5px solid rgba(255,255,255,0.3);
            border-radius: 8px;
            padding: 7px 16px;
            font-size: 0.8rem;
            font-weight: 600;
            text-decoration: none;
            display: flex; align-items: center; gap: 6px;
            transition: all 0.2s;
            backdrop-filter: blur(6px);
        }

        .back-btn:hover {
            background: rgba(255,255,255,0.28);
            color: #fff;
            transform: translateX(-2px);
        }

        /* ── Card Body ── */
        .form-card-body {
            padding: 28px 32px 32px;
        }

        /* ── Form Label ── */
        .form-label {
            font-weight: 700;
            font-size: 0.8rem;
            color: var(--blue-800);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 7px;
        }

        /* ── Input Group ── */
        .input-wrap {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 14px; top: 50%;
            transform: translateY(-50%);
            color: var(--blue-400);
            font-size: 15px;
            pointer-events: none;
        }

        .form-control {
            font-family: 'Plus Jakarta Sans', sans-serif;
            padding: 11px 14px 11px 40px;
            border-radius: 10px;
            border: 2px solid var(--blue-200);
            font-size: 0.88rem;
            color: var(--blue-900);
            background: var(--blue-50);
            transition: all 0.2s;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--blue-500);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(59,130,246,0.12);
        }

        .form-control::placeholder { color: #94a3b8; }

        /* ── Validation ── */
        .text-danger {
            font-size: 0.75rem;
            font-weight: 500;
            color: #dc2626 !important;
            margin-top: 4px;
            display: block;
        }

        /* ── Alert ── */
        .alert-danger {
            background: #fef2f2;
            border-left: 4px solid #ef4444;
            border-top: none; border-right: none; border-bottom: none;
            color: #991b1b;
            border-radius: 10px;
            padding: 14px 18px;
            font-size: 0.85rem;
            margin-bottom: 22px;
        }

        /* ── Divider ── */
        .form-divider {
            height: 1px;
            background: var(--blue-100);
            margin: 22px 0;
        }

        /* ── Submit Button ── */
        .btn-submit {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, var(--blue-700), var(--blue-500));
            color: #fff;
            border: none;
            border-radius: 11px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 700;
            font-size: 0.95rem;
            letter-spacing: 0.3px;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: 8px;
            box-shadow: 0 4px 18px rgba(37, 99, 235, 0.35);
            transition: all 0.2s;
            margin-top: 8px;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(37, 99, 235, 0.45);
        }

        .btn-submit:active { transform: translateY(0); }

        /* ── Animation ── */
        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ── Scrollbar ── */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--blue-50); }
        ::-webkit-scrollbar-thumb { background: var(--blue-300); border-radius: 10px; }
    </style>
</head>
<body>

    <div class="container py-5" style="max-width: 580px;">

        <div class="form-card mt-3">

            <!-- Header -->
            <div class="form-card-header">
                <div class="header-left">
                    <div class="header-icon">👤</div>
                    <div>
                        <div class="header-title">Add New User</div>
                        <div class="header-sub">ADMIN PANEL</div>
                    </div>
                </div>
                <a href="/Admin/UserList" class="back-btn">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>

            <!-- Body -->
            <div class="form-card-body">

                @if (!ModelState.IsValid)
                {
                    <div class="alert alert-danger d-flex gap-2">
                        <i class="bi bi-exclamation-circle-fill mt-1"></i>
                        <ul class="mb-0 ps-2">
                            @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()

                    <!-- Username -->
                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <div class="input-wrap">
                            <i class="bi bi-person input-icon"></i>
                            <input asp-for="Model.UserName" class="form-control" placeholder="Enter username" />
                        </div>
                        <span asp-validation-for="Model.UserName" class="text-danger"></span>
                    </div>

                    <!-- User Number -->
                    <div class="mb-3">
                        <label class="form-label">Phone Number</label>
                        <div class="input-wrap">
                            <i class="bi bi-hash input-icon"></i>
                            <input asp-for="Model.UserNumber" type="number" class="form-control" placeholder="Enter user number" />
                        </div>
                        <span asp-validation-for="Model.UserNumber" class="text-danger"></span>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <div class="input-wrap">
                            <i class="bi bi-envelope input-icon"></i>
                            <input asp-for="Model.Email" type="email" class="form-control" placeholder="Enter email" />
                        </div>
                        <span asp-validation-for="Model.Email" class="text-danger"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <div class="input-wrap">
                            <i class="bi bi-lock input-icon"></i>
                            <input asp-for="Model.UserPassword" type="password" class="form-control" placeholder="Enter password" />
                        </div>
                        <span asp-validation-for="Model.UserPassword" class="text-danger"></span>
                    </div>

                    <!-- Role ID -->
                    <div class="mb-3">
                        <label class="form-label">Role ID</label>
                        <div class="input-wrap">
                            <i class="bi bi-shield input-icon"></i>
                            <input asp-for="Model.RoleId" type="number" class="form-control" placeholder="Enter role ID" />
                        </div>
                    </div>

                    <div class="form-divider"></div>

                    <!-- Submit -->
                    <button type="submit" class="btn-submit">
                        <i class="bi bi-person-plus-fill"></i> Add User
                    </button>

                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>