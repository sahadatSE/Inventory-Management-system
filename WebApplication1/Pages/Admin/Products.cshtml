@page
@{
    ViewData["Title"] = "Products";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .prod-card {
        border: 2px solid #e2e5ea;
        border-radius: 14px;
        overflow: hidden;
        cursor: pointer;
        transition: transform .25s, box-shadow .25s, border-color .25s;
        background: #fff;
    }

        .prod-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 48px rgba(26,86,219,.15);
            border-color: #1a56db;
        }

            .prod-card:hover .card-img-top {
                transform: scale(1.07);
            }

    .card-img-top {
        transition: transform .4s ease;
        height: 200px;
        object-fit: cover;
    }

    .prod-card:hover .card-title {
        color: #1a56db;
    }

    .card-title {
        transition: color .2s;
        font-weight: 700;
    }

    .price-tag {
        font-size: 1.2rem;
        font-weight: 700;
        color: #1a56db;
    }

    .btn-view {
        transition: all .2s;
    }

    .prod-card:hover .btn-view {
        background: #1a56db;
        color: #fff;
        border-color: #1a56db;
    }
</style>

<div class="container py-5">
    <h2 class="mb-4 fw-bold">Products</h2>
    <div class="row row-cols-1 row-cols-md-3 g-4">

        <!-- Card 1 — Watch 1 -->
        <div class="col">
            <div class="prod-card h-100" data-bs-toggle="modal" data-bs-target="#modal1">
                <div style="overflow:hidden">
                    <img src="/image/watch1.jpeg" class="card-img-top w-100" alt="Watch 1" />
                </div>
                <div class="card-body p-3">
                    <span class="badge bg-success mb-2">New</span>
                    <h5 class="card-title">Watch 1</h5>
                    <p class="text-muted small">Elegant classic design with premium finish.</p>
                    <div class="d-flex align-items-center justify-content-between mt-2">
                        <span class="price-tag">$199</span>
                        <span style="color:#f0a500">★★★★★</span>
                    </div>
                    <button class="btn btn-outline-primary btn-view w-100 mt-3">View Details</button>
