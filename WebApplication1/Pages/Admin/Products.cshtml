@page "/Admin/Product"
@model WebApplication1.Pages.Admin.ProductModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit Product" : "Add Product";
}
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --blue-50:  #eff6ff;
            --blue-100: #dbeafe;
            --blue-200: #bfdbfe;
            --blue-300: #93c5fd;
            --blue-400: #60a5fa;
            --blue-500: #3b82f6;
            --blue-600: #2563eb;
            --blue-700: #1d4ed8;
            --blue-800: #1e40af;
            --blue-900: #1e3a8a;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #e0eaff 0%, #f0f5ff 50%, #e8f0fe 100%);
            min-height: 100vh;
            color: #1e3a8a;
        }

        body::before {
            content: '';
            position: fixed;
            left: 0; top: 0;
            width: 5px; height: 100%;
            background: linear-gradient(180deg, var(--blue-500), var(--blue-800));
            z-index: 999;
        }

        /* ── Header ── */
        .top-header {
            background: linear-gradient(135deg, var(--blue-800) 0%, var(--blue-600) 100%);
            padding: 18px 28px;
            display: flex; align-items: center; justify-content: space-between;
            box-shadow: 0 4px 24px rgba(30,64,175,0.35);
            border-radius: 14px;
            margin-bottom: 32px;
        }
        .header-left { display: flex; align-items: center; gap: 12px; }
        .header-icon {
            width: 44px; height: 44px;
            background: rgba(255,255,255,0.18);
            border-radius: 11px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
        }
        .header-title { color: #fff; font-weight: 800; font-size: 1.1rem; margin: 0; }
        .header-sub   { color: var(--blue-200); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.4px; }

        .btn-back {
            background: rgba(255,255,255,0.15);
            color: #fff;
            border: 1.5px solid rgba(255,255,255,0.3);
            border-radius: 8px;
            padding: 8px 18px;
            font-size: 0.82rem; font-weight: 600;
            text-decoration: none;
            display: flex; align-items: center; gap: 6px;
            transition: all 0.2s;
        }
        .btn-back:hover {
            background: rgba(255,255,255,0.28);
            color: #fff; transform: translateY(-1px);
        }

        /* ── Alert ── */
        .alert-danger {
            background: #fef2f2;
            border-left: 4px solid #ef4444;
            border-top: none; border-right: none; border-bottom: none;
            color: #991b1b; border-radius: 10px;
            padding: 13px 18px; font-size: 0.87rem; margin-bottom: 20px;
        }

        /* ── Form Card ── */
        .form-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 4px 30px rgba(30,64,175,0.10);
            border: 1px solid var(--blue-100);
            overflow: hidden;
            max-width: 520px;
            margin: 0 auto;
        }
        .form-card-header {
            background: linear-gradient(135deg, var(--blue-700), var(--blue-500));
            padding: 16px 24px;
            display: flex; align-items: center; gap: 10px;
        }
        .form-card-header h5 {
            color: #fff; font-weight: 700; font-size: 0.95rem; margin: 0;
        }
        .form-card-body { padding: 28px 24px; }

        /* ── Fields ── */
        .field-label {
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--blue-700);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
            display: flex; align-items: center; gap: 6px;
        }
        .field-input {
            width: 100%;
            padding: 11px 14px;
            border-radius: 10px;
            border: 2px solid var(--blue-200);
            background: #fff;
            font-size: 0.875rem;
            color: var(--blue-900);
            transition: all 0.2s;
            box-shadow: 0 1px 4px rgba(30,64,175,0.05);
        }
        .field-input:focus {
            outline: none;
            border-color: var(--blue-500);
            box-shadow: 0 0 0 4px rgba(59,130,246,0.12);
        }
        .field-input::placeholder { color: #94a3b8; }

        /* ── Price input group ── */
        .price-group {
            display: flex;
            border-radius: 10px;
            overflow: hidden;
            border: 2px solid var(--blue-200);
            transition: all 0.2s;
        }
        .price-group:focus-within {
            border-color: var(--blue-500);
            box-shadow: 0 0 0 4px rgba(59,130,246,0.12);
        }
        .price-prefix {
            background: var(--blue-50);
            color: var(--blue-700);
            font-weight: 700;
            font-size: 0.9rem;
            padding: 11px 14px;
            border-right: 2px solid var(--blue-200);
            display: flex; align-items: center;
        }
        .price-input {
            flex: 1;
            padding: 11px 14px;
            border: none;
            background: #fff;
            font-size: 0.875rem;
            color: var(--blue-900);
        }
        .price-input:focus { outline: none; }
        .price-input::placeholder { color: #94a3b8; }

        .validation-msg {
            font-size: 0.75rem;
            color: #dc2626;
            margin-top: 4px;
            display: block;
        }

        /* ── Buttons ── */
        .btn-submit {
            background: linear-gradient(135deg, var(--blue-700), var(--blue-500));
            color: #fff; border: none;
            border-radius: 10px; padding: 12px;
            font-weight: 700; font-size: 0.9rem;
            width: 100%; transition: all 0.2s;
            box-shadow: 0 4px 14px rgba(30,64,175,0.3);
            display: flex; align-items: center; justify-content: center; gap: 8px;
        }
        .btn-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(30,64,175,0.4);
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--blue-50); }
        ::-webkit-scrollbar-thumb { background: var(--blue-300); border-radius: 10px; }
    </style>
</head>
<body>

<div class="container-fluid px-4 py-4" style="max-width:900px; margin:0 auto;">

    <!-- Header -->
    <div class="top-header mt-3">
        <div class="header-left">
            <div class="header-icon">
                @(Model.IsEdit ? "✏️" : "📦")
            </div>
            <div>
                <div class="header-title">@ViewData["Title"]</div>
                
            </div>
        </div>
        <a href="/Admin/ProductList" class="btn-back">
            <i class="bi bi-arrow-left"></i> Product List
        </a>
    </div>

    <!-- Form Card -->
    <div class="form-card">
        <div class="form-card-header">
            <i class="bi bi-@(Model.IsEdit ? "pencil-fill" : "plus-circle-fill") text-white"></i>
            <h5>@ViewData["Title"]</h5>
        </div>
        <div class="form-card-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-danger d-flex align-items-start gap-2 mb-4">
                    <i class="bi bi-exclamation-circle-fill mt-1"></i>
                    <ul class="mb-0 ps-2">
                        @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IsEdit" />
                <input type="hidden" asp-for="ProductData.PId" />

                <div class="mb-4">
                    <label class="field-label">
                        <i class="bi bi-box-seam-fill"></i> Product Name
                    </label>
                    <input asp-for="ProductData.PName" class="field-input"
                           placeholder="Enter product name" />
                    <span asp-validation-for="ProductData.PName" class="validation-msg"></span>
                </div>

                <div class="mb-4">
                    <label class="field-label">
                        <i class="bi bi-tag-fill"></i> Category
                    </label>
                    <input asp-for="ProductData.Category" class="field-input"
                           placeholder="Enter category" />
                    <span asp-validation-for="ProductData.Category" class="validation-msg"></span>
                </div>

                <div class="mb-4">
                    <label class="field-label">
                        <i class="bi bi-currency-dollar"></i> Price
                    </label>
                    <div class="price-group">
                        <span class="price-prefix">$</span>
                        <input asp-for="ProductData.PPrice" type="number" step="0.01"
                               class="price-input" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="ProductData.PPrice" class="validation-msg"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn-submit">
                        <i class="bi bi-@(Model.IsEdit ? "check-circle-fill" : "plus-circle-fill")"></i>
                        @(Model.IsEdit ? "Update Product" : "Add Product")
                    </button>
                </div>

            </form>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>