@page
@model WebApplication1.Pages.Admin.StockListModel
@{
    ViewData["Title"] = "Stock List";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Stock List</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-5">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Available Stock Summary</h3>
        </div>
        <div class="card shadow mb-5">
            <div class="card-body p-0">
                <table class="table table-bordered table-hover mb-0">
                    <thead class="table-success">
                        <tr>
                            <th>#</th>
                            <th>Product Name</th>
                            <th>Total In</th>
                            <th>Total Out</th>
                            <th>Available Stock</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int j = 1;
                            if (Model.AvailableList.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">No data found.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.AvailableList)
                                {
                                    <tr>
                                        <td>@(j++)</td>
                                        <td>@item.P_Name</td>
                                        <td>@item.Quantity_In</td>
                                        <td>@item.Quantity_Out</td>
                                        <td>
                                            <span class="badge fs-6 @(item.Available_Stock > 0 ? "bg-success" : "bg-danger")">
                                                @item.Available_Stock
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>All Stock Records</h3>
            <a href="/Admin/Stock" class="btn btn-primary">+ Add New Stock</a>
        </div>
        <div class="card shadow">
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Product Name</th>
                            <th>Quantity In</th>
                            <th>Quantity Out</th>
                            <th>Available Stock</th>
                            <th>Added By</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                            if (Model.List.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted">No stock found.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.List)
                                {
                                    <tr>
                                        <td>@(i++)</td>
                                        <td>@item.P_Name</td>
                                        <td>@item.Quantity_In</td>
                                        <td>@item.Quantity_Out</td>
                                        <td>
                                            <span class="badge @(item.Available_Stock > 0 ? "bg-success" : "bg-danger")">
                                                @item.Available_Stock
                                            </span>
                                        </td>
                                        <td>@item.UserName</td>
                                        <td>@item.EntryDate.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt")</td>
                                        <td>
                                            <a href="/Admin/Stock?Id=@item.Stock_Id" class="btn btn-sm btn-warning">Edit</a>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>