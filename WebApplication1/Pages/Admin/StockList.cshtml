@page
@model WebApplication1.Pages.Admin.StockListModel
@{
    ViewData["Title"] = "Stock List";
}
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
        }

        .table th {
            font-weight: 600;
            color: #555;
            border-bottom: 2px solid #dee2e6;
        }

        .table td {
            vertical-align: middle;
            color: #333;
        }

        .stock-badge {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
        }

        .btn-edit {
            color: #0d6efd;
            background: none;
            border: none;
            font-weight: 500;
        }

            .btn-edit:hover {
                text-decoration: underline;
            }

        .btn-delete {
            color: #dc3545;
            background: none;
            border: none;
            font-weight: 500;
        }

            .btn-delete:hover {
                text-decoration: underline;
            }

        .search-input {
            border-radius: 8px;
            border: 1px solid #ddd;
            padding: 10px 16px;
        }

        .add-btn {
            border-radius: 8px;
            padding: 10px 20px;
        }

        .section-title {
            font-size: 1rem;
            font-weight: 700;
            color: #333;
        }
    </style>
</head>
<body>
    <div class="container mt-5">

        <h4 class="fw-bold mb-4">Stock List</h4>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- ১ম Table: সব Stock Entry -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <p class="section-title mb-0">📋 All Stock Entries</p>
            <div class="d-flex gap-3">
                <input type="text" id="searchInput" class="form-control search-input"
                       placeholder="Search by product name..." />
                <a href="/Admin/Stock" class="btn btn-primary add-btn text-nowrap">Add Stock</a>
            </div>
        </div>

        <div class="bg-white rounded shadow-sm mb-5">
            <table class="table mb-0" id="stockTable">
                <thead>
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Qty In</th>
                        <th>Qty Out</th>
                        <th>Added By</th>
                        <th>Entry Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Stocks.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">Stock empty</td>
                        </tr>
                    }
                    else
                    {
                        int i = 1;
                        foreach (var stock in Model.Stocks)
                        {
                            <tr>
                                <td class="ps-4">@(i++)</td>
                                <td>@(stock.Product?.PName ?? "-")</td>
                                <td>@stock.Category</td>
                                <td>$@stock.Price.ToString("F2")</td>
                                <td><span class="text-primary fw-bold">@stock.Quantity_In</span></td>
                                <td><span class="text-danger fw-bold">@stock.Quantity_Out</span></td>
                                <td>@stock.UserName</td>
                                <td>@stock.EntryDate.ToString("dd-MM-yyyy")</td>
                                <td>
                                    <a href="/Admin/Stock?Id=@stock.Stock_Id" class="btn-edit">Edit</a>
                                    <button class="btn-delete ms-2"
                                            onclick="confirmDelete('@stock.Stock_Id', '@(stock.Product?.PName ?? "-")')">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- ২য় Table: Available Stock Summary -->
        <p class="section-title mb-3">📦 Available Stock Summary</p>
        <div class="bg-white rounded shadow-sm mb-5">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Total Qty In</th>
                        <th>Total Qty Out</th>
                        <th>Available Stock</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AvailableStocks.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">কোনো Data পাওয়া যায়নি</td>
                        </tr>
                    }
                    else
                    {
                        int j = 1;
                        foreach (var item in Model.AvailableStocks)
                        {
                            int available = item.Quantity_In - item.Quantity_Out;
                            string stockColor = available == 0 ? "#fde8e8" : available <= 5 ? "#fff8e1" : "#e6f9f0";
                            string textColor = available == 0 ? "#dc3545" : available <= 5 ? "#f0a500" : "#28a745";
                            <tr>
                                <td class="ps-4">@(j++)</td>
                                <td>@(item.Product?.PName ?? "-")</td>
                                <td>@(item.Category ?? "-")</td>
                                <td><span class="text-primary fw-bold">@item.Quantity_In</span></td>
                                <td><span class="text-danger fw-bold">@item.Quantity_Out</span></td>
                                <td>
                                    <span class="stock-badge"
                                          style="background-color:@stockColor; color:@textColor;">
                                        @available
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">Delete Stock</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <strong id="deleteStockName"></strong> এর stock delete করতে চান?
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <form method="post" asp-page-handler="Delete">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" id="deleteStockId" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('searchInput').addEventListener('input', function () {
            const search = this.value.toLowerCase();
            document.querySelectorAll('#stockTable tbody tr').forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(search) ? '' : 'none';
            });
        });

        function confirmDelete(id, name) {
            document.getElementById('deleteStockId').value = id;
            document.getElementById('deleteStockName').innerText = name;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
</body>
</html>