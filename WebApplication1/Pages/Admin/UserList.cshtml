@page
@model WebApplication1.Pages.Admin.UserListModel
@{
    ViewData["Title"] = "User List";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: #f0f2f5;
        color: #1e2532;
    }

    .page-wrap {
        max-width: 1000px;
        margin: 0 auto;
        padding: 32px 20px;
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -.02em;
        margin: 0;
    }

        .page-title span {
            color: #3b82f6;
        }

    .btn-add {
        background: #3b82f6;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 700;
        font-size: .9rem;
        font-family: inherit;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background .2s, transform .15s;
        box-shadow: 0 4px 14px rgba(59,130,246,.35);
        text-decoration: none;
    }

        .btn-add:hover {
            background: #2563eb;
            transform: translateY(-2px);
            color: #fff;
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: #fff;
        border-radius: 14px;
        padding: 20px 18px;
        border: 1.5px solid #e5e7eb;
        transition: transform .2s, box-shadow .2s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0,0,0,.08);
        }

    .stat-ico {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-bottom: 12px;
    }

    .ico-blue {
        background: #eff6ff;
    }

    .ico-green {
        background: #f0fdf4;
    }

    .ico-amber {
        background: #fffbeb;
    }

    .stat-num {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1;
    }

    .num-blue {
        color: #3b82f6;
    }

    .num-green {
        color: #22c55e;
    }

    .num-amber {
        color: #f59e0b;
    }

    .stat-lbl {
        font-size: .75rem;
        font-weight: 700;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-top: 4px;
    }

    .table-card {
        background: #fff;
        border-radius: 16px;
        border: 1.5px solid #e5e7eb;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,.05);
    }

    .table-head-bar {
        padding: 16px 20px;
        border-bottom: 1.5px solid #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

        .table-head-bar h6 {
            font-weight: 700;
            margin: 0;
        }

    .search-inp {
        border: 1.5px solid #e5e7eb;
        border-radius: 9px;
        padding: 8px 12px;
        font-size: .85rem;
        font-family: inherit;
        outline: none;
        width: 200px;
        background: #f9fafb;
        transition: border-color .2s;
    }

        .search-inp:focus {
            border-color: #3b82f6;
            background: #fff;
        }

    .usr-tbl {
        width: 100%;
        border-collapse: collapse;
    }

        .usr-tbl thead th {
            background: #f9fafb;
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #9ca3af;
            padding: 11px 16px;
            border-bottom: 1.5px solid #f3f4f6;
            white-space: nowrap;
        }

        .usr-tbl tbody td {
            padding: 13px 16px;
            border-bottom: 1px solid #f3f4f6;
            font-size: .88rem;
            vertical-align: middle;
        }

        .usr-tbl tbody tr:last-child td {
            border-bottom: none;
        }

        .usr-tbl tbody tr {
            transition: background .12s;
        }

            .usr-tbl tbody tr:hover {
                background: #f8faff;
            }

    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: .85rem;
        color: #fff;
        flex-shrink: 0;
    }

    .user-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .role-pill {
        font-size: .72rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 999px;
    }

    .r-1 {
        background: #eff6ff;
        color: #3b82f6;
    }

    .r-2 {
        background: #fdf4ff;
        color: #a855f7;
    }

    .r-3 {
        background: #f0fdf4;
        color: #16a34a;
    }

    .act-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1.5px solid #e5e7eb;
        background: #fff;
        color: #6b7280;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all .18s;
        text-decoration: none;
    }

        .act-btn:hover {
            border-color: #3b82f6;
            color: #3b82f6;
            background: #eff6ff;
        }

        .act-btn.dl:hover {
            border-color: #ef4444;
            color: #ef4444;
            background: #fef2f2;
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #9ca3af;
    }
</style>

<div class="page-wrap">

    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <h1 class="page-title">👥 User <span>List</span></h1>
        <a href="/Admin/User" class="btn-add">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            Add User
        </a>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-ico ico-blue">👥</div>
            <div class="stat-num num-blue">@Model.Users.Count</div>
            <div class="stat-lbl">Total Users</div>
        </div>
        <div class="stat-card">
            <div class="stat-ico ico-green">🛡️</div>
            <div class="stat-num num-green">@Model.Users.Count(u => u.RoleId == 1)</div>
            <div class="stat-lbl">Admins</div>
        </div>
        <div class="stat-card">
            <div class="stat-ico ico-amber">👁️</div>
            <div class="stat-num num-amber">@Model.Users.Count(u => u.RoleId == 3)</div>
            <div class="stat-lbl">Viewers</div>
        </div>
    </div>

    <!-- Table -->
    <div class="table-card">
        <div class="table-head-bar">
            <h6>All Users</h6>
            <input class="search-inp" type="text" id="searchInp" placeholder="Search username…" oninput="filterTable()" />
        </div>

        <div class="table-responsive">
            <table class="usr-tbl" id="userTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Username</th>
                        <th>User Number</th>
                        <th>Role</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <div style="font-size:2.5rem;margin-bottom:10px">👤</div>
                                    <p>No users found. <a href="/Admin/User">Add your first user</a></p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (int i = 0; i < Model.Users.Count; i++)
                        {
                            var user = Model.Users[i];
                            var colors = new[] { "#3b82f6", "#8b5cf6", "#ec4899", "#f59e0b", "#10b981", "#ef4444" };
                            var clr = colors[i % colors.Length];
                            string roleLabel = user.RoleId == 1 ? "Admin" : user.RoleId == 2 ? "Editor" : "Viewer";
                            string roleCls = user.RoleId == 1 ? "r-1" : user.RoleId == 2 ? "r-2" : "r-3";

                            <tr class="user-row">
                                <td style="color:#9ca3af;font-size:.78rem">@(i + 1)</td>
                                <td>
                                    <div class="user-cell">
                                        <div class="avatar" style="background:@clr">
                                            @user.UserName[0].ToString().ToUpper()
                                        </div>
                                        <span style="font-weight:700" class="uname">@user.UserName</span>
                                    </div>
                                </td>
                                <td style="color:#6b7280">@user.UserNumber</td>
                                <td>
                                    <span class="role-pill @roleCls">@roleLabel</span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a href="/Admin/User?Id=@user.UserId" class="act-btn" title="Edit">
                                            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14c0 1.1.9 2 2 2h14a2 2 0 0 0 2-2v-7" />
                                                <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z" />
                                            </svg>
                                        </a>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@user.UserId" style="display:inline">
                                            <button type="submit" class="act-btn dl" title="Delete"
                                                    onclick="return confirm('Delete @user.UserName?')">
                                                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <polyline points="3 6 5 6 21 6" />
                                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4h6v2" />
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function filterTable() {
        var q = document.getElementById('searchInp').value.toLowerCase();
        var rows = document.querySelectorAll('.user-row');
        rows.forEach(function(row) {
            var name = row.querySelector('.uname').textContent.toLowerCase();
            row.style.display = name.indexOf(q) >= 0 ? '' : 'none';
        });
    }
</script>