@page
@model WebApplication1.Pages.Admin.UserListModel
@{
    ViewData["Title"] = "User List";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User List</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --blue-50: #eff6ff;
            --blue-100: #dbeafe;
            --blue-200: #bfdbfe;
            --blue-300: #93c5fd;
            --blue-400: #60a5fa;
            --blue-500: #3b82f6;
            --blue-600: #2563eb;
            --blue-700: #1d4ed8;
            --blue-800: #1e40af;
            --blue-900: #1e3a8a;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #e0eaff 0%, #f0f5ff 50%, #e8f0fe 100%);
            min-height: 100vh;
            color: #1e3a8a;
        }

            body::before {
                content: '';
                position: fixed;
                left: 0;
                top: 0;
                width: 5px;
                height: 100%;
                background: linear-gradient(180deg, var(--blue-500), var(--blue-800));
                z-index: 999;
            }

        /* ── Top Header ── */
        .top-header {
            background: linear-gradient(135deg, var(--blue-800) 0%, var(--blue-600) 100%);
            padding: 18px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 4px 24px rgba(30, 64, 175, 0.35);
            border-radius: 14px;
            margin-bottom: 24px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-icon {
            width: 44px;
            height: 44px;
            background: rgba(255,255,255,0.18);
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            backdrop-filter: blur(6px);
        }

        .header-title {
            color: #fff;
            font-weight: 800;
            font-size: 1.1rem;
            margin: 0;
        }

        .header-sub {
            color: var(--blue-200);
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.4px;
        }

        .btn-add {
            background: rgba(255,255,255,0.15);
            color: #fff;
            border: 1.5px solid rgba(255,255,255,0.3);
            border-radius: 8px;
            padding: 8px 18px;
            font-size: 0.82rem;
            font-weight: 600;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
            backdrop-filter: blur(6px);
        }

            .btn-add:hover {
                background: rgba(255,255,255,0.28);
                color: #fff;
                transform: translateY(-1px);
            }

        /* ── Stats ── */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: #fff;
            border-radius: 14px;
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: 0 2px 16px rgba(30, 64, 175, 0.08);
            border: 1px solid var(--blue-100);
        }

        .stat-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

            .stat-icon.blue {
                background: var(--blue-100);
                color: var(--blue-600);
            }

            .stat-icon.indigo {
                background: #e0e7ff;
                color: #4338ca;
            }

            .stat-icon.sky {
                background: #e0f2fe;
                color: #0284c7;
            }

        .stat-label {
            font-size: 0.72rem;
            font-weight: 600;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--blue-800);
            line-height: 1;
            margin-top: 2px;
        }

        /* ── Search ── */
        .search-wrap {
            position: relative;
            margin-bottom: 20px;
        }

        .search-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--blue-400);
            font-size: 15px;
            pointer-events: none;
        }

        .search-input {
            width: 100%;
            padding: 12px 18px 12px 44px;
            border-radius: 12px;
            border: 2px solid var(--blue-200);
            background: #fff;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.88rem;
            color: var(--blue-900);
            transition: all 0.2s;
            box-shadow: 0 2px 10px rgba(30,64,175,0.06);
        }

            .search-input:focus {
                outline: none;
                border-color: var(--blue-500);
                box-shadow: 0 0 0 4px rgba(59,130,246,0.12);
            }

            .search-input::placeholder {
                color: #94a3b8;
            }

        /* ── Table Card ── */
        .table-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 4px 30px rgba(30, 64, 175, 0.10);
            border: 1px solid var(--blue-100);
            overflow: hidden;
        }

        .table-card-header {
            background: linear-gradient(135deg, var(--blue-700), var(--blue-500));
            padding: 14px 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .table-card-header h6 {
                color: #fff;
                font-weight: 700;
                font-size: 0.9rem;
                margin: 0;
                display: flex;
                align-items: center;
                gap: 8px;
            }

        .table-count-badge {
            background: rgba(255,255,255,0.2);
            color: #fff;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 20px;
        }

        /* ── Table ── */
        .table {
            margin: 0;
        }

            .table thead tr {
                background: var(--blue-50);
            }

            .table thead th {
                font-weight: 700;
                font-size: 0.7rem;
                text-transform: uppercase;
                letter-spacing: 0.7px;
                color: var(--blue-700);
                border-bottom: 2px solid var(--blue-100);
                padding: 13px 16px;
                white-space: nowrap;
            }

            .table tbody tr {
                border-bottom: 1px solid #f1f5f9;
                transition: background 0.15s;
            }

                .table tbody tr:hover {
                    background: var(--blue-50);
                }

                .table tbody tr:last-child {
                    border-bottom: none;
                }

            .table tbody td {
                padding: 13px 16px;
                font-size: 0.86rem;
                color: #334155;
                vertical-align: middle;
            }

        /* ── Row number ── */
        .row-num {
            width: 28px;
            height: 28px;
            background: var(--blue-100);
            color: var(--blue-700);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.75rem;
        }

        /* ── Username ── */
        .user-name {
            font-weight: 700;
            color: var(--blue-900);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--blue-500), var(--blue-700));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 0.75rem;
            font-weight: 700;
            flex-shrink: 0;
        }

        /* ── Role badge ── */
        .role-badge {
            background: var(--blue-100);
            color: var(--blue-700);
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.72rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        /* ── Email ── */
        .email-cell {
            color: #475569;
            font-size: 0.83rem;
        }

        /* ── Action Buttons ── */
        .btn-edit {
            background: #fefce8;
            color: #854d0e;
            border: 1.5px solid #fde68a;
            border-radius: 8px;
            padding: 5px 12px;
            font-size: 0.76rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: all 0.2s;
        }

            .btn-edit:hover {
                background: #eab308;
                color: #fff;
                border-color: #eab308;
                transform: translateY(-1px);
            }

        .btn-delete {
            background: #fff0f0;
            color: #dc2626;
            border: 1.5px solid #fecaca;
            border-radius: 8px;
            padding: 5px 12px;
            font-size: 0.76rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: all 0.2s;
        }

            .btn-delete:hover {
                background: #dc2626;
                color: #fff;
                border-color: #dc2626;
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(220,38,38,0.25);
            }

        /* ── Empty State ── */
        .empty-state {
            padding: 60px 20px;
            text-align: center;
        }

        .empty-icon {
            width: 72px;
            height: 72px;
            background: var(--blue-50);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            margin: 0 auto 16px;
            color: var(--blue-300);
        }

        /* ── Alerts ── */
        .alert-success {
            background: #f0fdf4;
            border-left: 4px solid #22c55e;
            border-top: none;
            border-right: none;
            border-bottom: none;
            color: #166534;
            border-radius: 10px;
            padding: 13px 18px;
            font-size: 0.87rem;
            margin-bottom: 18px;
        }

        .alert-danger {
            background: #fef2f2;
            border-left: 4px solid #ef4444;
            border-top: none;
            border-right: none;
            border-bottom: none;
            color: #991b1b;
            border-radius: 10px;
            padding: 13px 18px;
            font-size: 0.87rem;
            margin-bottom: 18px;
        }

        /* ── Modal ── */
        .modal-content {
            border: none;
            border-radius: 18px;
            box-shadow: 0 25px 60px rgba(30,64,175,0.2);
            overflow: hidden;
        }

        .modal-header {
            background: linear-gradient(135deg, var(--blue-800), var(--blue-600));
            padding: 20px 24px;
            border: none;
        }

            .modal-header .modal-title {
                color: #fff;
                font-weight: 700;
                font-size: 1rem;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .modal-header .btn-close {
                filter: invert(1);
                opacity: 0.7;
            }

        .modal-body {
            padding: 24px;
            font-size: 0.9rem;
            color: #334155;
        }

        .modal-footer {
            padding: 16px 24px;
            border-top: 1px solid var(--blue-100);
            background: var(--blue-50);
        }

        .btn-cancel {
            background: #fff;
            color: #64748b;
            border: 1.5px solid #e2e8f0;
            border-radius: 9px;
            padding: 8px 20px;
            font-weight: 600;
            font-size: 0.84rem;
            transition: all 0.2s;
        }

            .btn-cancel:hover {
                background: #f1f5f9;
            }

        .btn-confirm-delete {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: #fff;
            border: none;
            border-radius: 9px;
            padding: 8px 22px;
            font-weight: 700;
            font-size: 0.84rem;
            box-shadow: 0 4px 14px rgba(220,38,38,0.3);
            transition: all 0.2s;
        }

            .btn-confirm-delete:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(220,38,38,0.4);
            }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(18px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: var(--blue-50);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--blue-300);
            border-radius: 10px;
        }
    </style>
</head>
<body>

    <div class="container-fluid px-4 py-4" style="max-width:1200px; margin:0 auto;">

        <!-- Header -->
        <div class="top-header mt-3">
            <div class="header-left">
                <div class="header-icon">👥</div>
                <div>
                    <div class="header-title">User List</div>
                    
                </div>
            </div>
            <a href="/Admin/User" class="btn-add">
                <i class="bi bi-person-plus-fill"></i> Add New User
            </a>
        </div>

        <!-- Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-circle-fill"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Stats -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon blue"><i class="bi bi-people-fill"></i></div>
                <div>
                    <div class="stat-label">Total Users</div>
                    <div class="stat-value">@Model.Users.Count</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon indigo"><i class="bi bi-shield-fill"></i></div>
                <div>
                    <div class="stat-label">Total Roles</div>
                    <div class="stat-value">@Model.Users.Select(u => u.RoleId).Distinct().Count()</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon sky"><i class="bi bi-envelope-fill"></i></div>
                <div>
                    <div class="stat-label">Registered</div>
                    <div class="stat-value">@Model.Users.Count</div>
                </div>
            </div>
        </div>

        <!-- Search -->
        <div class="search-wrap">
            <i class="bi bi-search search-icon"></i>
            <input type="text" id="searchInput" class="search-input"
                   placeholder="Search by username, email or role..." />
        </div>

        <!-- Table -->
        <div class="table-card">
            <div class="table-card-header">
                <h6><i class="bi bi-table"></i> All Users</h6>
                <span class="table-count-badge">@Model.Users.Count users</span>
            </div>

            <div class="table-responsive">
                <table class="table" id="userTable">
                    <thead>
                        <tr>
                            <th style="width:50px">#</th>
                            <th>Username</th>
                            <th>User Number</th>
                            <th>Email</th>
                            <th>Role ID</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Users.Any())
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="empty-state">
                                        <div class="empty-icon"><i class="bi bi-people"></i></div>
                                        <div style="font-weight:700; color:#64748b; font-size:1rem;">No users found</div>
                                        <div style="color:#94a3b8; font-size:0.83rem; margin-top:6px;">Users will appear here once added.</div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @for (int i = 0; i < Model.Users.Count; i++)
                            {
                                var user = Model.Users[i];
                                var initials = user.UserName?.Length > 0
                                ? user.UserName.Substring(0, 1).ToUpper()
                                : "?";
                                <tr>
                                    <td><div class="row-num">@(i + 1)</div></td>
                                    <td>
                                        <div class="user-name">
                                            <div class="user-avatar">@initials</div>
                                            @user.UserName
                                        </div>
                                    </td>
                                    <td style="color:#475569; font-weight:500;">@user.UserNumber</td>
                                    <td><span class="email-cell">@user.Email</span></td>
                                    <td>
                                        <span class="role-badge">
                                            <i class="bi bi-shield-fill"></i> @user.RoleId
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a href="/Admin/User?Id=@user.UserId" class="btn-edit">
                                                <i class="bi bi-pencil-fill"></i> Edit
                                            </a>
                                            <button class="btn-delete"
                                                    onclick="confirmDelete('@user.UserId', '@user.UserName')">
                                                <i class="bi bi-trash3"></i> Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-trash3-fill"></i> Delete User
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex align-items-start gap-3">
                        <div style="width:44px;height:44px;background:#fee2e2;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                        </div>
                        <div>
                            <div style="font-weight:700;color:#1e293b;margin-bottom:5px;">Are you sure?</div>
                            <div style="color:#64748b;font-size:0.86rem;">
                                <strong id="deleteUserName" style="color:#1e40af;"></strong> —  user permanently delete।
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer d-flex gap-2 justify-content-end">
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <form method="post" asp-page-handler="Delete" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="deleteUserId" />
                        <button type="submit" class="btn-confirm-delete">
                            <i class="bi bi-trash3-fill me-1"></i> Yes, Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('searchInput').addEventListener('input', function () {
            const search = this.value.toLowerCase();
            document.querySelectorAll('#userTable tbody tr').forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(search) ? '' : 'none';
            });
        });

        function confirmDelete(id, name) {
            document.getElementById('deleteUserId').value = id;
            document.getElementById('deleteUserName').innerText = name;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
</body>
</html>