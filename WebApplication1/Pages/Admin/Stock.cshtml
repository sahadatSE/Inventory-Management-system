@page
@model WebApplication1.Pages.Admin.StockModel
@{
    ViewData["Title"] = "Add Stock";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Add Stock</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Add New Stock</h4>
                    </div>
                    <div class="card-body">

                        @if (!ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <ul class="mb-0">
                                    @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        }

                        <form method="post">
                            @Html.AntiForgeryToken()
                            <input asp-for="Model.Stock_Id" type="hidden" />

                            <div class="mb-3">
                                <label class="form-label fw-bold">Product ID</label>
                                <input asp-for="Model.P_Id" type="number" class="form-control" placeholder="Enter product ID" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Product Name</label>
                                <input asp-for="Model.P_Name" class="form-control" placeholder="Enter product name" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Quantity In</label>
                                <input asp-for="Model.Quantity_In" type="number" class="form-control" placeholder="Enter quantity in" />
                                <span asp-validation-for="Model.Quantity_In" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Quantity Out</label>
                                <input asp-for="Model.Quantity_Out" type="number" class="form-control" placeholder="Enter quantity out" />
                                <span asp-validation-for="Model.Quantity_Out" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Entry Date</label>
                                <input type="text" class="form-control"
                                       value="@DateTime.Now.ToString("dd-MM-yyyy hh:mm tt")"
                                       readonly />
                                <small class="text-muted">Auto set on save</small>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Save Stock</button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>