@page
@model WebApplication1.Pages.Admin.OrderListModel
@{
    ViewData["Title"] = "Order List";
    
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --blue-50:  #eff6ff;
            --blue-100: #dbeafe;
            --blue-200: #bfdbfe;
            --blue-300: #93c5fd;
            --blue-400: #60a5fa;
            --blue-500: #3b82f6;
            --blue-600: #2563eb;
            --blue-700: #1d4ed8;
            --blue-800: #1e40af;
            --blue-900: #1e3a8a;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #e0eaff 0%, #f0f5ff 50%, #e8f0fe 100%);
            min-height: 100vh;
            color: #1e3a8a;
        }

        body::before {
            content: '';
            position: fixed;
            left: 0; top: 0;
            width: 5px; height: 100%;
            background: linear-gradient(180deg, var(--blue-500), var(--blue-800));
            z-index: 999;
        }

        /* ── Header ── */
        .top-header {
            background: linear-gradient(135deg, var(--blue-800) 0%, var(--blue-600) 100%);
            padding: 18px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 4px 24px rgba(30,64,175,0.35);
            border-radius: 14px;
            margin-bottom: 24px;
        }
        .header-left { display: flex; align-items: center; gap: 12px; }
        .header-icon {
            width: 44px; height: 44px;
            background: rgba(255,255,255,0.18);
            border-radius: 11px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
        }
        .header-title { color: #fff; font-weight: 800; font-size: 1.1rem; margin: 0; }
        .header-sub   { color: var(--blue-200); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.4px; }

        .btn-new-order {
            background: rgba(255,255,255,0.15);
            color: #fff;
            border: 1.5px solid rgba(255,255,255,0.3);
            border-radius: 8px;
            padding: 8px 18px;
            font-size: 0.82rem;
            font-weight: 600;
            text-decoration: none;
            display: flex; align-items: center; gap: 6px;
            transition: all 0.2s;
        }
        .btn-new-order:hover {
            background: rgba(255,255,255,0.28);
            color: #fff;
            transform: translateY(-1px);
        }

        /* ── Alerts ── */
        .alert-success {
            background: #f0fdf4;
            border-left: 4px solid #22c55e;
            border-top: none; border-right: none; border-bottom: none;
            color: #166534; border-radius: 10px;
            padding: 13px 18px; font-size: 0.87rem; margin-bottom: 18px;
        }
        .alert-danger {
            background: #fef2f2;
            border-left: 4px solid #ef4444;
            border-top: none; border-right: none; border-bottom: none;
            color: #991b1b; border-radius: 10px;
            padding: 13px 18px; font-size: 0.87rem; margin-bottom: 18px;
        }

        /* ── Search ── */
        .search-wrap { position: relative; flex: 1; }
        .search-wrap .bi-search {
            position: absolute; left: 14px; top: 50%;
            transform: translateY(-50%);
            color: var(--blue-400); font-size: 14px; pointer-events: none;
        }
        .search-input {
            width: 100%;
            padding: 10px 16px 10px 40px;
            border-radius: 10px;
            border: 2px solid var(--blue-200);
            background: #fff;
            font-size: 0.86rem;
            color: var(--blue-900);
            transition: all 0.2s;
            box-shadow: 0 2px 10px rgba(30,64,175,0.06);
        }
        .search-input:focus {
            outline: none;
            border-color: var(--blue-500);
            box-shadow: 0 0 0 4px rgba(59,130,246,0.12);
        }
        .search-input::placeholder { color: #94a3b8; }

        /* ── Table Card ── */
        .table-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 4px 30px rgba(30,64,175,0.10);
            border: 1px solid var(--blue-100);
            overflow: hidden;
        }
        .table-card-header {
            background: linear-gradient(135deg, var(--blue-700), var(--blue-500));
            padding: 14px 22px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .table-card-header h6 {
            color: #fff; font-weight: 700; font-size: 0.9rem;
            margin: 0; display: flex; align-items: center; gap: 8px;
        }
        .table-count-badge {
            background: rgba(255,255,255,0.2);
            color: #fff; font-size: 0.72rem; font-weight: 700;
            padding: 3px 10px; border-radius: 20px;
        }

        /* ── Table ── */
        .table { margin: 0; }
        .table thead th {
            background: var(--blue-50);
            font-weight: 700; font-size: 0.7rem;
            text-transform: uppercase; letter-spacing: 0.7px;
            color: var(--blue-700);
            border-bottom: 2px solid var(--blue-100);
            padding: 13px 16px; white-space: nowrap;
        }
        .table tbody tr { border-bottom: 1px solid #f1f5f9; transition: background 0.15s; }
        .table tbody tr:hover { background: var(--blue-50); }
        .table tbody tr:last-child { border-bottom: none; }
        .table tbody td { padding: 12px 16px; font-size: 0.855rem; color: #334155; vertical-align: middle; }

        /* ── Row number ── */
        .row-num {
            width: 28px; height: 28px;
            background: var(--blue-100); color: var(--blue-700);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 0.75rem;
        }

        /* ── Order ID ── */
        .order-id {
            font-weight: 700; color: var(--blue-800);
            background: var(--blue-100); color: var(--blue-700);
            padding: 3px 10px; border-radius: 20px;
            font-size: 0.78rem; font-weight: 700;
            display: inline-block;
        }

        /* ── Product badges ── */
        .product-tag {
            background: var(--blue-50);
            color: var(--blue-700);
            border: 1px solid var(--blue-200);
            border-radius: 6px;
            padding: 2px 8px;
            font-size: 0.7rem;
            font-weight: 600;
            display: inline-block;
            margin: 2px 2px 2px 0;
        }

        /* ── Status select ── */
        .status-select {
            border: 2px solid var(--blue-200);
            border-radius: 8px;
            padding: 4px 8px;
            font-size: 0.76rem;
            font-weight: 600;
            color: var(--blue-800);
            background: #fff;
            cursor: pointer;
            transition: all 0.2s;
            width: 120px;
        }
        .status-select:focus {
            outline: none;
            border-color: var(--blue-500);
            box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
        }

        /* ── Action buttons ── */
        .btn-details {
            background: #fefce8; color: #854d0e;
            border: 1.5px solid #fde68a; border-radius: 8px;
            padding: 5px 12px; font-size: 0.76rem; font-weight: 600;
            text-decoration: none;
            display: inline-flex; align-items: center; gap: 5px;
            transition: all 0.2s;
        }
        .btn-details:hover {
            background: #eab308; color: #fff;
            border-color: #eab308; transform: translateY(-1px);
        }
        .btn-delete {
            background: #fff0f0; color: #dc2626;
            border: 1.5px solid #fecaca; border-radius: 8px;
            padding: 5px 12px; font-size: 0.76rem; font-weight: 600;
            cursor: pointer;
            display: inline-flex; align-items: center; gap: 5px;
            transition: all 0.2s;
        }
        .btn-delete:hover {
            background: #dc2626; color: #fff;
            border-color: #dc2626; transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(220,38,38,0.25);
        }

        /* ── Empty state ── */
        .empty-state { padding: 60px 20px; text-align: center; }
        .empty-icon {
            width: 68px; height: 68px;
            background: var(--blue-50); border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 28px; margin: 0 auto 14px; color: var(--blue-300);
        }

        /* ── Modal ── */
        .modal-content {
            border: none; border-radius: 18px;
            box-shadow: 0 25px 60px rgba(30,64,175,0.2);
            overflow: hidden;
        }
        .modal-header {
            background: linear-gradient(135deg, var(--blue-800), var(--blue-600));
            padding: 20px 24px; border: none;
        }
        .modal-header .modal-title {
            color: #fff; font-weight: 700; font-size: 1rem;
            display: flex; align-items: center; gap: 8px;
        }
        .modal-header .btn-close { filter: invert(1); opacity: 0.7; }
        .modal-body { padding: 24px; font-size: 0.9rem; color: #334155; }
        .modal-footer {
            padding: 16px 24px;
            border-top: 1px solid var(--blue-100);
            background: var(--blue-50);
        }
        .btn-cancel {
            background: #fff; color: #64748b;
            border: 1.5px solid #e2e8f0; border-radius: 9px;
            padding: 8px 20px; font-weight: 600; font-size: 0.84rem;
            transition: all 0.2s;
        }
        .btn-cancel:hover { background: #f1f5f9; }
        .btn-confirm-delete {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: #fff; border: none; border-radius: 9px;
            padding: 8px 22px; font-weight: 700; font-size: 0.84rem;
            box-shadow: 0 4px 14px rgba(220,38,38,0.3);
            transition: all 0.2s;
        }
        .btn-confirm-delete:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(220,38,38,0.4);
        }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: var(--blue-50); }
        ::-webkit-scrollbar-thumb { background: var(--blue-300); border-radius: 10px; }
    </style>
</head>
<body>

<div class="container-fluid px-4 py-4" style="max-width:1300px; margin:0 auto;">

    <!-- Header -->
    <div class="top-header mt-3">
        <div class="header-left">
            <div class="header-icon">📋</div>
            <div>
                <div class="header-title">Order List</div>
                
            </div>
        </div>
        <a href="/Admin/Order" class="btn-new-order">
            <i class="bi bi-plus-circle-fill"></i> New Order
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-circle-fill"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search -->
    <div class="d-flex gap-3 mb-3 align-items-center">
        <div class="search-wrap">
            <i class="bi bi-search"></i>
            <input type="text" id="searchInput" class="search-input"
                   placeholder="Search by order ID..." />
        </div>
    </div>

    <!-- Table -->
    <div class="table-card">
        <div class="table-card-header">
            <h6><i class="bi bi-bag-check-fill"></i> All Orders</h6>
            <span class="table-count-badge">@Model.Orders.Count orders</span>
        </div>
        <div class="table-responsive">
            <table class="table" id="orderTable">
                <thead>
                    <tr>
                        <th style="width:50px">#</th>
                        <th>Order ID</th>
                        <th>Products</th>
                        <th>Total Amount</th>
                        <th>Order Date</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Orders.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <div class="empty-icon"><i class="bi bi-bag-x"></i></div>
                                    <div style="font-weight:700;color:#64748b;font-size:1rem;">No orders found</div>
                                    <div style="color:#94a3b8;font-size:0.83rem;margin-top:6px;">Orders will appear here once placed.</div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int i = 1;
                        foreach (var order in Model.Orders)
                        {
                            string statusColor = order.OrderStatus switch
                            {
                                "Confirmed" => "success",
                                "Cancelled" => "danger",
                                _           => "warning"
                            };
                            <tr>
                                <td><div class="row-num">@(i++)</div></td>
                                <td><span class="order-id">#@order.OrderId</span></td>
                                <td>
                                    @foreach (var detail in order.OrderDetails)
                                    {
                                        <span class="product-tag">
                                            @(detail.Product?.PName ?? "-") &bull; @(detail.Product?.Category ?? "-") x@detail.Quantity
                                        </span>
                                    }
                                </td>
                                <td style="font-weight:700;color:#16a34a;">$@order.TotalAmount.ToString("F2")</td>
                                <td>
                                    <span style="background:var(--blue-100);color:var(--blue-700);padding:3px 10px;border-radius:20px;font-size:0.72rem;font-weight:700;">
                                        @order.OrderDate.ToLocalTime().ToString("dd-MM-yyyy")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-@statusColor px-3 py-2" style="font-size:0.72rem;">
                                        @order.OrderStatus
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">
                                        
                                        
                                        <button class="btn-delete" onclick="confirmDelete('@order.OrderId')">
                                            <i class="bi bi-trash3"></i> Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-trash3-fill"></i> Delete Order
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-start gap-3">
                    <div style="width:44px;height:44px;background:#fee2e2;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                    </div>
                    <div>
                        <div style="font-weight:700;color:#1e293b;margin-bottom:5px;">Are you sure?</div>
                        <div style="color:#64748b;font-size:0.86rem;">
                           are you want to delete this ??
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex gap-2 justify-content-end">
                <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Delete" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" id="deleteOrderId" />
                    <button type="submit" class="btn-confirm-delete">
                        <i class="bi bi-trash3-fill me-1"></i> Yes, Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Status Update Form -->
<form method="post" asp-page-handler="UpdateStatus" id="statusForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="OrderId" id="statusOrderId" />
    <input type="hidden" name="Status"  id="statusValue"   />
</form>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.getElementById('searchInput').addEventListener('input', function () {
        const search = this.value.toLowerCase();
        document.querySelectorAll('#orderTable tbody tr').forEach(row => {
            row.style.display = row.innerText.toLowerCase().includes(search) ? '' : 'none';
        });
    });

    function confirmDelete(id) {
        document.getElementById('deleteOrderId').value = id;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

    function updateStatus(orderId, status) {
        document.getElementById('statusOrderId').value = orderId;
        document.getElementById('statusValue').value   = status;
        document.getElementById('statusForm').submit();
    }
</script>
</body>
</html>