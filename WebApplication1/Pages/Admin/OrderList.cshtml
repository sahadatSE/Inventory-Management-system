@page
@model WebApplication1.Pages.Admin.OrderListModel
@{
    ViewData["Title"] = "Order List";
}
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
        }

        .table th {
            font-weight: 600;
            color: #555;
            border-bottom: 2px solid #dee2e6;
        }

        .table td {
            vertical-align: middle;
            color: #333;
        }

        .btn-view {
            color: #0d6efd;
            background: none;
            border: none;
            font-weight: 500;
        }

            .btn-view:hover {
                text-decoration: underline;
            }

        .btn-delete {
            color: #dc3545;
            background: none;
            border: none;
            font-weight: 500;
        }

            .btn-delete:hover {
                text-decoration: underline;
            }

        .search-input {
            border-radius: 8px;
            border: 1px solid #ddd;
            padding: 10px 16px;
        }
    </style>
</head>
<body>
    <div class="container mt-5">

        <h4 class="fw-bold mb-4">Order List</h4>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="d-flex gap-3 mb-4">
            <input type="text" id="searchInput" class="form-control search-input"
                   placeholder="Search by order ID..." />
            <a href="/Admin/Order" class="btn btn-primary text-nowrap">+ New Order</a>
        </div>

        <div class="bg-white rounded shadow-sm">
            <table class="table mb-0" id="orderTable">
                <thead>
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Order ID</th>
                        <th>Products</th>
                        <th>Total Amount</th>
                        <th>Order Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Orders.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5"> Order can not get</td>
                        </tr>
                    }
                    else
                    {
                        int i = 1;
                        foreach (var order in Model.Orders)
                        {
                            string statusColor = order.OrderStatus switch
                            {
                                "Confirmed" => "success",
                                "Cancelled" => "danger",
                                _ => "warning"
                            };
                            <tr>
                                <td class="ps-4">@(i++)</td>
                                <td class="fw-bold">#@order.OrderId</td>
                                <td>
                                    @foreach (var detail in order.OrderDetails)
                                    {
                                        <span class="badge bg-light text-dark border me-1">
                                            @(detail.Product?.PName ?? "-") x@detail.Quantity
                                        </span>
                                    }
                                </td>
                                <td class="fw-bold text-success">$@order.TotalAmount.ToString("F2")</td>
                                <td>@order.OrderDate.ToLocalTime().ToString("dd-MM-yyyy")</td>
                                <td>
                                    <span class="badge bg-@statusColor">@order.OrderStatus</span>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm"
                                            onchange="updateStatus(@order.OrderId, this.value)"
                                            style="width:120px;">
                                        @if (order.OrderStatus == "Pending")
                                        {
                                            <option value="Pending" selected>Pending</option>
                                            <option value="Confirmed">Confirmed</option>
                                            <option value="Cancelled">Cancelled</option>
                                        }
                                        else if (order.OrderStatus == "Confirmed")
                                        {
                                            <option value="Pending">Pending</option>
                                            <option value="Confirmed" selected>Confirmed</option>
                                            <option value="Cancelled">Cancelled</option>
                                        }
                                        else
                                        {
                                            <option value="Pending">Pending</option>
                                            <option value="Confirmed">Confirmed</option>
                                            <option value="Cancelled" selected>Cancelled</option>
                                        }
                                    </select>
                                    <a href="/Admin/OrderDetails?OrderId=@order.OrderId"
                                       class="btn-view ms-2">Details</a>
                                    <button class="btn-delete ms-2"
                                            onclick="confirmDelete('@order.OrderId')">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">Delete Order</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    এই order delete করতে চান?
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <form method="post" asp-page-handler="Delete">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" id="deleteOrderId" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Update Form -->
    <form method="post" asp-page-handler="UpdateStatus" id="statusForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="OrderId" id="statusOrderId" />
        <input type="hidden" name="Status" id="statusValue" />
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('searchInput').addEventListener('input', function () {
            const search = this.value.toLowerCase();
            document.querySelectorAll('#orderTable tbody tr').forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(search) ? '' : 'none';
            });
        });

        function confirmDelete(id) {
            document.getElementById('deleteOrderId').value = id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        function updateStatus(orderId, status) {
            document.getElementById('statusOrderId').value = orderId;
            document.getElementById('statusValue').value = status;
            document.getElementById('statusForm').submit();
        }
    </script>
</body>
</html>