@page
@model WebApplication1.Pages.Admin.SupplierModel
@{
    ViewData["Title"] = "Supplier";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Supplier</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-5">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card shadow" style="max-width:480px; margin:0 auto;">
            <div class="card-header text-white" style="background-color:#0d6efd;">
                <h5 class="mb-0">@(Model.Model.SId == 0 ? "Add Supplier" : "Edit Supplier")</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Model.SId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Supplier Name</label>
                        <input asp-for="Model.SName" class="form-control" placeholder="Enter supplier name" />
                        <span asp-validation-for="Model.SName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input asp-for="Model.SEmail" type="email" class="form-control" placeholder="Enter email" />
                        <span asp-validation-for="Model.SEmail" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Phone Number</label>
                        <input asp-for="Model.SNumber" class="form-control" placeholder="Enter phone number" />
                        <span asp-validation-for="Model.SNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Address</label>
                        <input asp-for="Model.SAdress" class="form-control" placeholder="Enter address" />
                        <span asp-validation-for="Model.SAdress" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary w-100">
                            @(Model.Model.SId == 0 ? "Save" : "Update")
                        </button>
                        <a asp-page="/Admin/SupplierList" class="btn btn-secondary w-100">Back</a>
                    </div>

                </form>
            </div>
        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>